@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}

<style>
    .about-wrapper {
        min-height: 100vh;
        width: 100%;
        padding-top: 120px;
        padding-bottom: 80px;
        background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url('/Content/Images/Studio.jpg') no-repeat center center/cover fixed;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="about-wrapper">
    <div class="row" style="width: 100%; max-width: 650px;">
        <div class="col s12">
            <div class="card custom-card">
                <div class="card-content">
                    <span class="card-title" style="text-align:center">About StageSync</span>
                    <div class="row">
                        <div class="col s12">
                            <p style="text-align:justify; margin-bottom: 25px; color: #cfd8dc; font-size: 1.05rem; line-height: 1.6;">
                                StageSync is a live performance and gig management application designed to help independent bands, venue managers, and booking agents seamlessly organize upcoming events and performance schedules.
                            </p>
                        </div>

                        <div class="col s12">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th>Feature / Tech</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>System Purpose</td>
                                        <td>Gig & Band Schedule Tracking</td>
                                    </tr>
                                    <tr>
                                        <td>Framework</td>
                                        <td>ASP.NET MVC & AngularJS</td>
                                    </tr>
                                    <tr>
                                        <td>UI Styling</td>
                                        <td>Materialize CSS</td>
                                    </tr>
                                    <tr>
                                        <td>Version</td>
                                        <td>1.0.0</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="col s12" style="margin-top: 30px;">
                            <a class="waves-effect waves-light btn-large" style="width:100%; background-color: #8bc34a; color: #121212; font-weight: bold;" href="/Modules/HomePage">BACK TO HOME</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>