@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}

<div class="container page-container" style="padding-top: 40px; padding-bottom: 50px;">

    <!-- Header banner -->
    <div class="row">
        <div class="col s12">
            <div class="glass-card card-padding center-align" style="padding: 36px 20px;">
                <h3 class="stagesync-title" style="margin: 0; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; font-size: 2.5rem; color: var(--stagesync-lime);">
                    ABOUT <span style="color: #ffffff;">STAGESYNC</span>
                </h3>
                <p class="grey-text text-lighten-1" style="margin: 10px 0 0 0; font-size: 1.1rem; font-weight: 300;">
                    Stage and performance management for live shows, venues, and rehearsal studios.
                </p>
            </div>
        </div>
    </div>

    <!-- main body/card -->
    <div class="row">
        <div class="col s12">
            <div class="glass-card glass-card-body">
                <h5 class="white-text" style="margin-top: 0;">
                    <i class="material-icons left" style="color: var(--stagesync-lime);">info</i>
                    System Overview
                </h5>
                <div class="clearfix"></div>
                <hr style="border-color: rgba(255,255,255,0.08); margin: 20px 0;" />

                <div class="responsive-table">
                    <table class="highlight stagesync-table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">FEATURE / TECH</th>
                                <th>DESCRIPTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong class="white-text">System Purpose</strong></td>
                                <td>Performer onboarding, account management, and live show operations.</td>
                            </tr>
                            <tr>
                                <td><strong class="white-text">Backend</strong></td>
                                <td>ASP.NET MVC (C# Razor)</td>
                            </tr>
                            <tr>
                                <td><strong class="white-text">Frontend</strong></td>
                                <td>AngularJS with Materialize CSS and custom styling.</td>
                            </tr>
                            <tr>
                                <td><strong class="white-text">Theme</strong></td>
                                <td>Dark studio glassmorphism, built for low-light control rooms.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- back to home button -->
    <div class="center-align" style="margin-top: 25px;">
        <button type="button" class="btn waves-effect btn-lime" ng-click="redirectHomePage()" style="padding: 0 30px; height: 45px; line-height: 45px; font-weight: 700;">
            <i class="material-icons left">arrow_back</i>
            BACK TO HOME
        </button>
    </div>

</div>