@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
    
 }<div class="row">
    <div class="col s4 m4 l4"></div>
    <div class="col s4 m4 l4">
        <div class="card blue lighten-4">
            <div class="card-content white-text">
                <span class="card-title" style="text-align:center">About StageSync</span>
                <div class="row">
                    <div class="col s12">
                        <p style="text-align:justify; margin-bottom: 15px;">
                            StageSync is a live performance and gig management application designed to help independent bands, venue managers, and booking agents seamlessly organize upcoming events and performance schedules.
                        </p>
                    </div>

                    <!-- Tech Stack / Features Table -->
                    <div class="col s12 m12 l12">
                        <table>
                            <thead>
                                <tr>
                                    <th>Feature / Tech</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>System Purpose</td>
                                    <td>Gig & Band Schedule Tracking</td>
                                </tr>
                                <tr>
                                    <td>Framework</td>
                                    <td>ASP.NET MVC & AngularJS</td>
                                </tr>
                                <tr>
                                    <td>UI Styling</td>
                                    <td>Materialize CSS</td>
                                </tr>
                                <tr>
                                    <td>Version</td>
                                    <td>1.0.0</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col s12" style="margin-top: 20px;">
                        <a class="waves-effect waves-light btn-large" style="width:100%" href="/Home/Index">BACK TO HOME</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col s4 m4 l4"></div>
</div>