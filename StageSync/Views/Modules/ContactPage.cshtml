@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}

<div class="container page-container" style="padding-top: 40px; padding-bottom: 50px;">

    <!-- head banner/card -->
    <div class="row">
        <div class="col s12">
            <div class="glass-card card-padding center-align" style="padding: 36px 20px;">
                <h3 class="stagesync-title" style="margin: 0; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; font-size: 2.5rem; color: var(--stagesync-lime);">
                    GET IN <span style="color: #ffffff;">TOUCH</span>
                </h3>
                <p class="grey-text text-lighten-1" style="margin: 10px 0 0 0; font-size: 1.1rem; font-weight: 300;">
                    Reach the StageSync production team and technical operations unit.
                </p>
            </div>
        </div>
    </div>

    <!-- contact details -->
    <div class="row">
        <div class="col s12">
            <div class="glass-card glass-card-body">
                <h5 class="white-text" style="margin-top: 0;">
                    <i class="material-icons left" style="color: var(--stagesync-lime);">contact_support</i>
                    Communication Channels
                </h5>
                <div class="clearfix"></div>
                <hr style="border-color: rgba(255,255,255,0.08); margin: 20px 0;" />

                <div class="responsive-table">
                    <table class="highlight stagesync-table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">CHANNEL</th>
                                <th>DETAILS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong class="white-text">Email</strong></td>
                                <td>support@stagesync.com</td>
                            </tr>
                            <tr>
                                <td><strong class="white-text">Hotline</strong></td>
                                <td>+63 123 123 321</td>
                            </tr>
                            <tr>
                                <td><strong class="white-text">Control Room</strong></td>
                                <td>Building 3, Studio Wing, Live Ops Floor</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- back home button -->
    <div class="center-align" style="margin-top: 25px;">
        <button type="button" class="btn waves-effect btn-lime" ng-click="redirectHomePage()" style="padding: 0 30px; height: 45px; line-height: 45px; font-weight: 700;">
            <i class="material-icons left">arrow_back</i>
            BACK TO HOME
        </button>
    </div>

</div>