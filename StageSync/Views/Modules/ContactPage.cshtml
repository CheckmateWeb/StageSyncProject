@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}

<style>
    .contact-wrapper {
        min-height: 100vh;
        width: 100%;
        padding-top: 120px;
        padding-bottom: 80px;
        background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url('/Content/Images/studios.png') no-repeat center center/cover fixed;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="contact-wrapper">
    <div class="row" style="width: 100%; max-width: 650px;">
        <div class="col s12">
            <div class="card custom-card">
                <div class="card-content">
                    <span class="card-title" style="text-align:center">Contact Support</span>
                    <form>
                        <div class="row">
                            <div class="input-field col s12">
                                <input id="contact_name" type="text" class="validate" ng-model="ContactName">
                                <label for="contact_name">Full Name</label>
                            </div>
                            <div class="input-field col s12">
                                <input id="contact_email" type="email" class="validate" ng-model="ContactEmail">
                                <label for="contact_email">Email Address</label>
                            </div>
                            <div class="input-field col s12">
                                <input id="contact_msg" type="text" class="validate" ng-model="ContactMessage">
                                <label for="contact_msg">Message</label>
                            </div>
                            <div class="col s6">
                                <a class="waves-effect waves-light btn-large" style="width:100%; background-color: #8bc34a; color: #121212; font-weight: bold;" ng-click="alertFunc('Message Sent!')">SEND</a>
                            </div>
                            <div class="col s6">
                                <a class="waves-effect waves-light btn-large red accent-4" style="width:100%; font-weight: bold;" ng-click="clearFunc()">CANCEL</a>
                            </div>

                            <div class="col s12" style="margin-top:30px;">
                                <table class="custom-table">
                                    <thead>
                                        <tr>
                                            <th>Channel</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Email</td>
                                            <td>support@stagesync.com</td>
                                        </tr>
                                        <tr>
                                            <td>Hotline</td>
                                            <td>+1 (800) 555-SYNC</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>