@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}<div class="row">
    <div class="col s4 m4 l4"></div>
    <div class="col s4 m4 l4">
        <div class="card blue lighten-4">
            <div class="card-content white-text">
                <span class="card-title" style="text-align:center">Gig Registration</span>
                <div class="row">
                    <form class="col s12">
                        <div class="row">
                            <div class="input-field col s6">
                                <input id="last_name" type="text" class="validate" ng-model="FName">
                                <label for="last_name">*Band Name</label>
                            </div>
                            <div class="input-field col s6">
                                <input id="last_name" type="text" class="validate" ng-model="MName">
                                <label for="last_name">*Venue Name</label>
                            </div>
                            <div class="input-field col s12 m12 l12">
                                <input id="last_name" type="text" class="validate" ng-model="LName">
                                <label for="last_name">*Performance Role</label>
                            </div>
                            <div class=" col s6 m6 l6">
                                <a class="waves-effect waves-light btn-large" style="width:100%" ng-click="registrationFunc()">SUBMIT</a>
                            </div>
                            <div class=" col s6 m6 l6">
                                <a class="waves-effect waves-light btn-large #d50000 red accent-4" style="width:100%" ng-click="clearFunc()">CANCEL</a>
                            </div>
                            <!--Table-->
                            <div class="col s12 m12 l12">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Band Name</th>
                                            <th>Venue Name</th>
                                            <th>Performance Role</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <tr ng-repeat="udata in userarray">
                                            <td>{{udata.firstname}}</td>
                                            <td>{{udata.middlename}}</td>
                                            <td>{{udata.lastname}}</td>
                                            <td>
                                                <div class="col s6 m6 l6">
                                                    <a class="waves-effect waves-light btn-large" style="width:100%" ng-click="editFunc($index)">EDIT</a>
                                                </div>
                                                <div class="col s6 m6 l6">
                                                    <a class="waves-effect waves-light btn-large #d50000 red accent-4" style="width:100%" ng-click="deleteFunc($index)">DELETE</a>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>

                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="col s4 m4 l4"></div>
</div>