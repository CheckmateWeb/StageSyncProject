@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}

<style>
    .hero-container {
        position: relative;
        height: 100vh;
        width: 100%;
        background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), 
                    url('/Content/Images/concert.jpg') no-repeat center center/cover;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: #ffffff;
    }

    .hero-title {
        font-size: 5rem;
        font-weight: 900;
        letter-spacing: 3px;
        line-height: 1.1;
        margin-bottom: 30px;
        text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.7);
    }

    .btn-hero {
        background-color: #8bc34a !important;
        color: #121212 !important;
        font-size: 1.1rem;
        font-weight: 800;
        padding: 0 45px;
        height: 56px;
        line-height: 56px;
        border-radius: 28px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .btn-hero:hover {
        background-color: #7cb342 !important;
        transform: translateY(-2px);
    }

    @@media (max-width: 600px) {
        .hero-title { font-size: 3rem; }
    }
</style>

<div class="hero-container">
    <h1 class="hero-title">WELCOME TO<br />STAGESYNC</h1>
    <a href="/Modules/RegistrationPage" class="waves-effect waves-light btn-large btn-hero">
        REGISTER NOW
    </a>
</div>