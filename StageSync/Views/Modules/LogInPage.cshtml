@{
    ViewBag.Title = "Login";
    ViewBag.BodyClass = "bg-login";
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}

<div class="row" style="margin-bottom: 0;">
    <div class="col s12 m8 l6 offset-m2 offset-l3">

        <!-- Yung Brand -->
        <div class="glass-card center-align" style="margin-bottom: 15px; padding: 20px;">
            <h4 style="color: var(--stagesync-lime); font-weight: 900; letter-spacing: 2px; margin: 0; text-transform: uppercase;">
                STAGESYNC CONSOLE
            </h4>
            <p style="color: var(--stagesync-slate-dim); font-size: 0.9rem; margin: 5px 0 0 0;">
                Command your show, cue by cue.
            </p>
        </div>

        <!-- LogIn form card -->
        <div class="glass-card">
            <div class="glass-card-header">
                <h5><i class="material-icons left" style="color: var(--stagesync-lime);">lock_outline</i> Crew & Performer Login</h5>
                <p>Sign in to access the stage console</p>
            </div>
            <div class="glass-card-body">
                <form name="loginForm" ng-submit="login()">
                    <div class="input-field stagesync-input">
                        <input id="login_username" type="text" ng-model="loginData.Username" minlength="3" maxlength="20" required autocomplete="off" />
                        <label for="login_username">Username *</label>
                    </div>

                    <div class="input-field stagesync-input" style="position: relative;">
                        <input id="login_password" type="{{showPassword ? 'text' : 'password'}}" ng-model="loginData.Password" minlength="3" maxlength="20" required />
                        <label for="login_password">Password *</label>
                        <i class="material-icons"
                           ng-click="showPassword = !showPassword"
                           style="position: absolute; right: 10px; top: 12px; cursor: pointer; color: var(--stagesync-slate-dim);">
                            {{showPassword ? 'visibility_off' : 'visibility'}}
                        </i>
                    </div>

                    <div style="margin-top: 24px; display: flex; gap: 12px;">
                        <button type="submit" class="btn btn-lime waves-effect" style="flex: 1;">
                            <i class="material-icons left">vpn_key</i> LOGIN
                        </button>
                        <button type="button" class="btn btn-outline-lime waves-effect" ng-click="clearLogin()">
                            <i class="material-icons left">clear</i> CLEAR
                        </button>
                    </div>
                </form>

                <div class="center-align" style="margin-top: 20px;">
                    <span style="color: var(--stagesync-slate-dim); font-size: 0.85rem;">New to the crew?</span>
                    <a href="@Url.Action("RegistrationPage", "Modules")" style="color: var(--stagesync-lime); font-weight: 700; margin-left: 5px;">Register here</a>
                </div>
            </div>
        </div>

    </div>
</div>