@{
    Layout = "~/Views/Shared/_StageSyncLayout.cshtml";
}

<style>
    .login-wrapper {
        min-height: 100vh;
        width: 100%;
        padding-top: 120px;
        padding-bottom: 80px;
        background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url('/Content/Images/guitar.jpg') no-repeat center center/cover fixed;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="login-wrapper">
    <div class="row" style="width: 100%; max-width: 450px;">
        <div class="col s12">
            <div class="card custom-card">
                <div class="card-content">
                    <span class="card-title" style="text-align:center">StageSync Login</span>
                    <form>
                        <div class="row">
                            <div class="input-field col s12">
                                <input id="username" type="text" class="validate" ng-model="Username">
                                <label for="username">*Username</label>
                            </div>
                            <div class="input-field col s12">
                                <input id="password" type="password" class="validate" ng-model="Password">
                                <label for="password">*Password</label>
                            </div>
                            <div class="col s6">
                                <a class="waves-effect waves-light btn-large" style="width:100%; background-color: #8bc34a; color: #121212; font-weight: bold;" ng-click="loginFunc()">LOGIN</a>
                            </div>
                            <div class="col s6">
                                <a class="waves-effect waves-light btn-large red accent-4" style="width:100%; font-weight: bold;" ng-click="clearFunc()">CLEAR</a>
                            </div>
                            <div class="col s12" style="text-align:center; margin-top:25px;">
                                <p style="color:#b0bec5">Don't have an account? <a href="/Modules/RegistrationPage" style="color:#8bc34a; font-weight:bold;">Register here</a></p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>