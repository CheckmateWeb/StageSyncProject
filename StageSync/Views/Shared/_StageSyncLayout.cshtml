    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/angular.min.js"></script>
    <script src="~/Scripts/StageSyncScripts/Module.js"></script>
    <script src="~/Scripts/StageSyncScripts/Service.js"></script>
    <script src="~/Scripts/StageSyncScripts/Controller.js"></script>
